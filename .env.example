# Rust API
SCOUTNEWS_BIND=127.0.0.1:8080
SCOUTNEWS_DEMO_MODE=false
DATABASE_URL=postgres://scoutnews:scoutnews@localhost:5432/scoutnews
WEB_ORIGIN=http://127.0.0.1:5173
# Optional, explicit original-publisher browser acquisition. Empty disables it.
# The local launcher supplies the project Node/script paths and defaults to OpenAI.
SCOUTNEWS_BROWSER_ARTICLE_HOSTS=openai.com,www.openai.com
SCOUTNEWS_BROWSER_HEADLESS=false
COPILOT_GATEWAY_URL=http://127.0.0.1:8787

# Optional OAuth App authorization. Local GitHub/Copilot login needs none of these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8080/api/v1/auth/github/callback

# Copilot Gateway
COPILOT_GATEWAY_BIND=127.0.0.1
COPILOT_GATEWAY_PORT=8787
# Generate a random local secret; the API and Gateway must use the same value.
COPILOT_GATEWAY_SHARED_SECRET=
# Summary model and rolling-24h budget are persisted in Settings.
# New database defaults: gpt-5.6-terra, 20 attempts; the supported limit is 1-5000.
# Existing saved settings (including a 5000-attempt limit) are preserved on restart.
# Both automatic and manual calls, including failures, count towards that budget.

# Reserved configuration only; Azure OpenAI invocation is not implemented in 0.2.
# It is not an available fallback and must never be selected silently.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=
